# Neon Postgres — runtime memakai connection string pooled (-pooler) + pgbouncer=true
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/gradly?pgbouncer=true&sslmode=verify-full"
# Prisma CLI/migrasi memakai connection string langsung (tanpa -pooler)
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.region.aws.neon.tech/gradly?sslmode=verify-full"
AUTH_SECRET="<openssl rand -base64 32>"
AUTH_TRUST_HOST="true"
# Public base URL, used to build absolute links (email, cron)
APP_URL=https://<project>.vercel.app
# optional, inert without real creds:
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Supabase Storage — bucket privat untuk SKTM/KIP-K, bukti transfer, portofolio
SUPABASE_URL="https://<project>.supabase.co"
# Kunci rahasia baru (sb_secret_...); service_role lama juga diterima
SUPABASE_SECRET_KEY="<secret key — jangan pakai anon key>"
SUPABASE_BUCKET="gradly-private"

# Resend API key for transactional emails
RESEND_API_KEY=
# Sender email address (must be verified in Resend)
MAIL_FROM=

# Shared secret for /api/cron/*; generate with `openssl rand -hex 32`.
# Vercel Cron otomatis mengirim `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=

# Kontak yang tampil di situs (kosong = belum ditampilkan)
NEXT_PUBLIC_CONTACT_EMAIL=
# Nomor WhatsApp/telepon untuk kontak
NEXT_PUBLIC_CONTACT_PHONE=
# Alamat studio/operasional
NEXT_PUBLIC_CONTACT_ADDRESS=
# Nama bank untuk instruksi pembayaran manual
NEXT_PUBLIC_PAYMENT_BANK_NAME=
# Nomor rekening tujuan pembayaran manual
NEXT_PUBLIC_PAYMENT_BANK_ACCOUNT=
# Nama pemilik rekening tujuan pembayaran manual
NEXT_PUBLIC_PAYMENT_ACCOUNT_HOLDER=
